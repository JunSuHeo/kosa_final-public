APP_ENV=local
AUTH_MODE=mock
AI_MODE=mock
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=openai/gpt-6.1-sol
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=240
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional repository connections. Leave unset when unused.
LOCAL_REPOSITORY_ROOT=
GITHUB_LOCAL_TOKEN=
GITHUB_USER_TOKENS={}

# Optional GitHub App user authorization. Set all five on API and worker.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=
GITHUB_APP_SLUG=
GITHUB_TOKEN_ENCRYPTION_KEY=
