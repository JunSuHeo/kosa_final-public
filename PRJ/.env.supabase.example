# Supabase Dashboard → Connect → Session pooler (port 5432) or Direct connection.
# Replace and URL-encode the database password. Keep this value server-side.
# DATABASE_URL='postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require'
DATABASE_URL=
# Migration owner connection. Runtime DATABASE_URL should use a login inheriting studio_runtime.
MIGRATION_DATABASE_URL=
AUTH_MODE=supabase
AUTO_MIGRATE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only: Auth admin secret/service_role key. Never VITE_* or browser storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Used only by the explicit offline transfer command, never by worker.
SOURCE_DATABASE_URL=
